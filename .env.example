# ontologyMVP 本地环境模板。
# 使用方式：cp .env.example .env，然后填入真实值；.env 已被 .gitignore 排除。
# 真实 Secret 只允许通过环境变量注入，严禁提交到仓库。

# ---- 必填：核心依赖（缺失时应用启动快速失败） ----
# 以下两项供“无 Docker 本地运行”使用（uv run uvicorn / python -m apps.worker.main）；
# docker compose 下由 compose 显式覆盖为 postgres / bolt://neo4j:7687，无需修改。
POSTGRES_HOST=127.0.0.1
NEO4J_URI=bolt://127.0.0.1:7687

POSTGRES_USER=ontology
# 请替换为本地随机生成的密码（例如：openssl rand -base64 24）
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ontology

NEO4J_USER=neo4j
# 请替换为本地随机生成的密码
NEO4J_PASSWORD=change-me-neo4j

# ---- 可选能力项：留空 = 能力不可用（应用以 DEGRADED 运行，不伪装可用） ----
# TuShare Pro Token（https://tushare.pro/）
TUSHARE_TOKEN=
# LLM API Key
LLM_API_KEY=

# ---- 通用（有安全默认值，可覆盖） ----
ENVIRONMENT=local
LOG_LEVEL=INFO
