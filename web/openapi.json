    ]
   }
  },
  "/admin/capabilities/{api_name}/reset": {
   "post": {
    "description": "熔断解除（issue #44）：SCHEMA_CHANGED → 单发验证探针 → AVAILABLE。\n\n审计每次状态迁移（actor/reason/前态/后态）；二次确认（reason +\nconfirm: true）；解除验证探针失败自动回滚熔断。",
    "operationId": "reset_capability_endpoint_admin_capabilities__api_name__reset_post",
    "parameters": [
     {
      "in": "path",
      "name": "api_name",
      "required": true,
      "schema": {
       "title": "Api Name",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CapabilityResetRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Reset Capability Endpoint Admin Capabilities  Api Name  Reset Post",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Reset Capability Endpoint",
    "tags": [
     "admin"
    ]
   }
  },
