      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "NumericFilter": {
    "description": "财务筛选：只使用 financial_metric_catalog 白名单中的指标。\n\nPeriodRule 与 operator/fiscal_years 必须一致（验收 5 的口径约束）：\n- LAST_N_FY            ⇒ fiscal_years == N；\n- LAST_3_FY_TOTAL_POSITIVE ⇒ operator=TOTAL_POSITIVE 且 fiscal_years=3；\n- CONSECUTIVE_3_FY_POSITIVE ⇒ operator=CONSECUTIVE_POSITIVE 且 fiscal_years=3。",
    "properties": {
     "fiscal_years": {
      "default": 3,
      "maximum": 10.0,
      "minimum": 1.0,
      "title": "Fiscal Years",
      "type": "integer"
     },
     "metric_code": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Metric Code",
      "type": "string"
     },
     "operator": {
      "$ref": "#/components/schemas/PathOperator"
     },
     "period_rule": {
      "default": "LAST_3_FY",
      "maxLength": 50,
      "title": "Period Rule",
      "type": "string"
     },
     "threshold": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Threshold"
     }
    },
    "required": [
     "metric_code",
     "operator"
    ],
    "title": "NumericFilter",
    "type": "object"
   },
   "PathOperator": {
    "enum": [
     "TOTAL_POSITIVE",
     "CONSECUTIVE_POSITIVE",
     "MIN_VALUE",
     "MAX_VALUE"
    ],
    "title": "PathOperator",
    "type": "string"
   },
   "QueryIntent": {
    "enum": [
     "ENTITY_LOOKUP",
     "SEMANTIC_SCREEN",
     "EXPLAIN_RELATION",
     "TIMELINE",
     "COMPARE",
     "EVIDENCE_SEARCH"
    ],
    "title": "QueryIntent",
    "type": "string"
   },
   "QueryPlan": {
    "description": "受控查询计划：Planner 输出的唯一合法形态。",
    "properties": {
     "as_of": {
      "anyOf": [
