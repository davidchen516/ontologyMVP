       },
       {
        "type": "null"
       }
      ]
     },
     "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
     },
     "semantic_filter": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/SemanticFilter"
       },
       {
        "type": "null"
       }
      ]
     },
     "subject": {
      "anyOf": [
