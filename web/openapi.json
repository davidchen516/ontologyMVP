       },
       {
        "type": "null"
       }
      ]
     },
     "timeout_seconds": {
      "default": 30,
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Timeout Seconds",
      "type": "integer"
     }
    },
    "required": [
