{
 "components": {
  "schemas": {
   "CapabilityResetRequest": {
    "description": "解除请求体（issue #44 二次确认语义）。\n\nStrictBool 拒绝 \"yes\"/1 等隐式真值：confirm 必须是显式 JSON true；\nreason 非空。缺字段/畸形体由 FastAPI 统一 422，不走手写解析。",
    "properties": {
     "confirm": {
      "title": "Confirm",
      "type": "boolean"
     },
     "reason": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
     }
    },
    "required": [
     "reason",
     "confirm"
    ],
    "title": "CapabilityResetRequest",
    "type": "object"
   },
   "EntityRef": {
    "description": "实体引用：ID 或名称+类型，不信任用户输入的自由表名/列名。",
    "properties": {
     "entity_id": {
      "anyOf": [
       {
        "format": "uuid",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Entity Id"
     },
     "entity_type": {
      "pattern": "^(Company|Security|Product|Theme|Concept|Industry)$",
      "title": "Entity Type",
      "type": "string"
     },
     "name_hint": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name Hint"
     }
    },
    "required": [
     "entity_type"
    ],
    "title": "EntityRef",
    "type": "object"
   },
   "GroundedResult": {
