{
 "components": {
  "schemas": {
   "EntityRef": {
    "description": "实体引用：ID 或名称+类型，不信任用户输入的自由表名/列名。",
    "properties": {
     "entity_id": {
      "anyOf": [
       {
        "format": "uuid",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Entity Id"
     },
     "entity_type": {
      "pattern": "^(Company|Security|Product|Theme|Concept|Industry)$",
      "title": "Entity Type",
      "type": "string"
     },
     "name_hint": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name Hint"
     }
    },
    "required": [
     "entity_type"
    ],
    "title": "EntityRef",
    "type": "object"
   },
   "GroundedResult": {
    "description": "每个命中公司的结构化证据包（验收 10 + issue #11 验收 8）。\n\n证券/标准产品/原文引文/双时态有效期由查询链路加载——\n每条经营结论可回溯至 Claim 与可定位 Evidence。",
    "properties": {
     "business_stage": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Business Stage"
     },
     "claim_ids": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
     },
     "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
     },
     "company_name": {
      "title": "Company Name",
      "type": "string"
     },
     "currency": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Currency"
     },
     "data_freshness": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Data Freshness"
     },
     "evidence_ids": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
     },
     "evidence_quotes": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Evidence Quotes",
      "type": "array"
     },
     "evidence_state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Evidence State"
     },
     "financial_detail": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Financial Detail",
      "type": "array"
     },
     "financial_value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Financial Value"
     },
     "reasoning_path": {
      "items": {
       "type": "string"
      },
      "title": "Reasoning Path",
      "type": "array"
     },
     "report_period": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Report Period"
     },
     "security_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Security Code"
     },
     "standard_product": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Standard Product"
     },
     "valid_from": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Valid From"
     },
     "valid_to": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Valid To"
     }
    },
    "required": [
     "company_id",
     "company_name"
    ],
    "title": "GroundedResult",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "NumericFilter": {
    "description": "财务筛选：只使用 financial_metric_catalog 白名单中的指标。\n\nPeriodRule 与 operator/fiscal_years 必须一致（验收 5 的口径约束）：\n- LAST_N_FY            ⇒ fiscal_years == N；\n- LAST_3_FY_TOTAL_POSITIVE ⇒ operator=TOTAL_POSITIVE 且 fiscal_years=3；\n- CONSECUTIVE_3_FY_POSITIVE ⇒ operator=CONSECUTIVE_POSITIVE 且 fiscal_years=3。",
    "properties": {
     "fiscal_years": {
      "default": 3,
      "maximum": 10.0,
      "minimum": 1.0,
      "title": "Fiscal Years",
      "type": "integer"
     },
     "metric_code": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Metric Code",
      "type": "string"
     },
     "operator": {
      "$ref": "#/components/schemas/PathOperator"
     },
     "period_rule": {
      "default": "LAST_3_FY",
      "maxLength": 50,
      "title": "Period Rule",
      "type": "string"
     },
     "threshold": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Threshold"
     }
    },
    "required": [
     "metric_code",
     "operator"
    ],
    "title": "NumericFilter",
    "type": "object"
   },
   "PathOperator": {
    "enum": [
     "TOTAL_POSITIVE",
     "CONSECUTIVE_POSITIVE",
     "MIN_VALUE",
     "MAX_VALUE"
    ],
    "title": "PathOperator",
    "type": "string"
   },
   "QueryIntent": {
    "enum": [
     "ENTITY_LOOKUP",
     "SEMANTIC_SCREEN",
     "EXPLAIN_RELATION",
     "TIMELINE",
     "COMPARE",
     "EVIDENCE_SEARCH"
    ],
    "title": "QueryIntent",
    "type": "string"
   },
   "QueryPlan": {
    "description": "受控查询计划：Planner 输出的唯一合法形态。",
    "properties": {
     "as_of": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     },
     "evidence_required": {
      "default": true,
      "title": "Evidence Required",
      "type": "boolean"
     },
     "intent": {
      "$ref": "#/components/schemas/QueryIntent"
     },
     "known_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Known At"
     },
     "max_results": {
      "default": 50,
      "maximum": 100.0,
      "minimum": 1.0,
      "title": "Max Results",
      "type": "integer"
     },
     "numeric_filter": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/NumericFilter"
       },
       {
        "type": "null"
       }
      ]
     },
     "object_entity": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/EntityRef"
       },
       {
        "type": "null"
       }
      ]
     },
     "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
     },
     "semantic_filter": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/SemanticFilter"
       },
       {
        "type": "null"
       }
      ]
     },
     "subject": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/EntityRef"
       },
       {
        "type": "null"
       }
      ]
     },
     "timeout_seconds": {
      "default": 30,
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Timeout Seconds",
      "type": "integer"
     }
    },
    "required": [
     "intent"
    ],
    "title": "QueryPlan",
    "type": "object"
   },
   "QueryRequest": {
    "description": "查询请求：直接传入受控 QueryPlan（LLM Planner 后续可选）。",
    "properties": {
     "natural_question": {
      "anyOf": [
       {
        "maxLength": 2000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Natural Question"
     },
     "plan": {
      "$ref": "#/components/schemas/QueryPlan"
     }
    },
    "required": [
     "plan"
    ],
    "title": "QueryRequest",
    "type": "object"
   },
   "QueryResponse": {
    "description": "Grounded 结构化响应：不添加结构化结果中不存在的任何实体。",
    "properties": {
     "conflicts": {
      "items": {
       "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
     },
     "degradation_notes": {
      "items": {
       "type": "string"
      },
      "title": "Degradation Notes",
      "type": "array"
     },
     "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "excluded": {
      "items": {
       "type": "string"
      },
      "title": "Excluded",
      "type": "array"
     },
     "intent": {
      "$ref": "#/components/schemas/QueryIntent"
     },
     "period_rule": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Period Rule"
     },
     "query_id": {
      "format": "uuid",
      "title": "Query Id",
      "type": "string"
     },
     "results": {
      "items": {
       "$ref": "#/components/schemas/GroundedResult"
      },
      "title": "Results",
      "type": "array"
     },
     "status": {
      "$ref": "#/components/schemas/QueryStatus"
     },
     "trace_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Trace Id"
     },
     "unknowns": {
      "items": {
       "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
     }
    },
    "required": [
     "query_id",
     "status",
     "intent"
    ],
    "title": "QueryResponse",
    "type": "object"
   },
   "QueryStatus": {
    "enum": [
     "RECEIVED",
     "PLANNED",
     "RUNNING",
     "SUCCEEDED",
     "FAILED",
     "CANCELLED",
     "REJECTED",
     "DEGRADED"
    ],
    "title": "QueryStatus",
    "type": "string"
   },
   "ScreenRequest": {
    "description": "筛选请求：语义条件 + 财务条件的简化入口。\n\n前置约束与 QueryPlan 模型一致（非法组合在请求层即 422）；\n注入载荷在计划构造层被拒（同样走受控 422）。",
    "properties": {
     "as_of": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     },
     "business_stage": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Business Stage"
     },
     "concept_name": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Concept Name"
     },
     "evidence_required": {
      "default": true,
      "title": "Evidence Required",
      "type": "boolean"
     },
     "fiscal_years": {
      "default": 3,
      "title": "Fiscal Years",
      "type": "integer"
     },
     "known_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Known At"
     },
     "max_results": {
      "default": 50,
      "maximum": 100.0,
      "minimum": 1.0,
      "title": "Max Results",
      "type": "integer"
     },
     "metric_code": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Metric Code"
     },
     "operator": {
      "$ref": "#/components/schemas/PathOperator",
      "default": "TOTAL_POSITIVE"
     },
     "period_rule": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Period Rule"
     },
     "threshold": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Threshold"
     }
    },
    "title": "ScreenRequest",
    "type": "object"
   },
   "SemanticFilter": {
    "description": "语义筛选：本体概念/关系/阶段——只使用白名单谓词。",
    "properties": {
     "business_stage": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Business Stage"
     },
     "concept_name": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Concept Name"
     },
     "max_hops": {
      "default": 2,
      "maximum": 4.0,
      "minimum": 1.0,
      "title": "Max Hops",
      "type": "integer"
     },
     "relation_type": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Relation Type"
     }
    },
    "title": "SemanticFilter",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
