@prefix stock: <https://ontology.example.com/stock#> .
@prefix product: <https://ontology.example.com/product#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://ontology.example.com/product>
    a owl:Ontology ;
    owl:imports <https://ontology.example.com/stock> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "人形机器人产品与产业链词表"@zh ;
    dcterms:description "股票本体MVP首批标准产品、别名、上下位和主题关系。"@zh ;
    dcterms:created "2026-09-28"^^xsd:date .

product:HumanoidRobotProductScheme
    a skos:ConceptScheme ;
    skos:prefLabel "人形机器人产品分类体系"@zh ;
    skos:prefLabel "Humanoid Robot Product Scheme"@en ;
    dcterms:version "0.1.0" .

# ---------------------------------------------------------------------------
# Theme and top-level categories
# ---------------------------------------------------------------------------

product:HumanoidRobot
    a skos:Concept, stock:Theme ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:topConceptOf product:HumanoidRobotProductScheme ;
    skos:prefLabel "人形机器人"@zh ;
    skos:prefLabel "Humanoid Robot"@en ;
    skos:altLabel "具身智能机器人"@zh ;
    skos:definition "以类人形态执行感知、决策和动作任务的机器人主题。该主题节点用于研究归类，不代表某公司已形成相关收入。"@zh .

product:WholeRobot
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "人形机器人整机"@zh ;
    skos:altLabel "机器人本体"@zh .

product:JointAndActuation
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "关节与执行器"@zh ;
    skos:altLabel "运动执行系统"@zh .

product:PerceptionSystem
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "感知系统"@zh .

product:MotionControlSystem
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "运动控制系统"@zh .

product:PowerAndThermal
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "电源与热管理"@zh .

product:CoreMaterialAndPart
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "核心材料与通用零部件"@zh .

product:ManufacturingAndTestingEquipment
    a skos:Concept, stock:ProductCategory ;
    skos:inScheme product:HumanoidRobotProductScheme ;
    skos:broader product:HumanoidRobot ;
    stock:partOfTheme product:HumanoidRobot ;
    skos:prefLabel "制造与测试设备"@zh .

