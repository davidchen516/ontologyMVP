# Related concepts that must not be treated as equivalent.
product:HarmonicReducer skos:related product:PrecisionBearing .
product:FramelessTorqueMotor skos:related product:Encoder .
product:IntegratedJoint skos:related product:SixAxisForceTorqueSensor .

# Explicitly state non-equivalence by keeping platform themes outside this scheme.
# Platform concept membership is modeled with stock:taggedAs, not skos:exactMatch.
