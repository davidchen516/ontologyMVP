@prefix stock: <https://ontology.example.com/stock#> .
@prefix product: <https://ontology.example.com/product#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://ontology.example.com/stock/shapes>
    a owl:Ontology ;
    rdfs:label "股票本体MVP SHACL约束"@zh ;
    rdfs:comment "校验RDF/图投影；PostgreSQL专用字面值由Pydantic和数据库约束补充校验。"@zh .

# ---------------------------------------------------------------------------
# Company, security and platform concept
# ---------------------------------------------------------------------------

stock:CompanyShape
    a sh:NodeShape ;
    sh:targetClass stock:Company ;
    sh:property [
        sh:path stock:canonicalKey ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Company必须具有唯一稳定业务键。"@zh
    ] .

stock:SecurityShape
    a sh:NodeShape ;
    sh:targetClass stock:Security ;
    sh:property [
        sh:path stock:canonicalKey ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Security必须具有稳定业务键。"@zh
    ] ;
    sh:property [
        sh:path stock:tsCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{6}\\.(SH|SZ|BJ)$" ;
        sh:message "A股ts_code必须符合000001.SZ、600000.SH或北交所格式。"@zh
    ] ;
    sh:property [
        sh:path stock:issuedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class stock:Company ;
        sh:message "Security必须且只能关联一个当前发行公司。"@zh
    ] ;
    sh:property [
        sh:path stock:listedOn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class stock:Exchange ;
        sh:message "Security必须关联一个交易所。"@zh
    ] .

stock:ConceptShape
    a sh:NodeShape ;
    sh:targetClass stock:Concept ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "平台概念必须有显示名称。"@zh
    ] ;
    sh:property [
        sh:path stock:sourcePlatform ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("EASTMONEY" "THS" "TUSHARE" "OTHER") ;
        sh:message "平台概念必须记录来源平台。"@zh
    ] .

# ---------------------------------------------------------------------------
# Product/SKOS taxonomy
# ---------------------------------------------------------------------------

stock:ProductConceptShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
        sh:message "每个SKOS概念至少有一个prefLabel，且每种语言只能有一个。"@zh
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:ConceptScheme ;
        sh:message "产品概念必须属于一个ConceptScheme。"@zh
    ] .

stock:ProductNoSelfBroaderShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "产品概念不能将自身作为broader节点。"@zh ;
        sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this
            WHERE { $this skos:broader $this . }
        """
    ] .

stock:ProductHierarchyCycleShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "产品分类层级存在循环。"@zh ;
        sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this
            WHERE { $this skos:broader+ $this . }
        """
    ] .

# ---------------------------------------------------------------------------
# Claim
# ---------------------------------------------------------------------------

stock:ClaimShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:closed false ;
    sh:property [
        sh:path stock:canonicalKey ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Claim必须有稳定ID。"@zh
    ] ;
    sh:property [
        sh:path stock:claimSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Claim必须且只能有一个主体。"@zh
    ] ;
    sh:property [
        sh:path stock:predicateCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "ISSUES" "LISTED_ON" "CLASSIFIED_AS" "TAGGED_AS"
            "PRODUCES" "DEVELOPS" "HAS_TECHNOLOGY_RESERVE"
            "SAMPLES_TO" "SUPPLIES_TO" "USES_TECHNOLOGY"
            "HAS_REVENUE_FROM" "DENIES_INVOLVEMENT"
            "CONTROLS" "HOLDS" "HAS_SEGMENT" "MAPPED_TO_PRODUCT"
            "VERIFIED_RELEVANT_TO" "DIRECT_EXPOSURE_TO"
            "SECOND_ORDER_EXPOSURE_TO"
        ) ;
        sh:message "Claim谓词必须在MVP白名单内。"@zh
    ] ;
    sh:property [
        sh:path stock:claimObject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "进入图谱投影的Claim必须且只能有一个IRI对象。"@zh
    ] ;
    sh:property [
        sh:path stock:claimStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "EXTRACTED" "VALIDATED" "NEEDS_REVIEW" "ACCEPTED"
            "CONTRADICTED" "SUPERSEDED" "REJECTED"
        ) ;
        sh:message "Claim状态值无效。"@zh
    ] ;
    sh:property [
        sh:path stock:businessStage ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "TECHNOLOGY_RESERVE" "RESEARCH" "PROTOTYPE"
            "SAMPLE_VALIDATION" "SMALL_BATCH" "MASS_PRODUCTION"
            "UNKNOWN"
        ) ;
        sh:message "业务阶段值无效。收入披露和公司否认属于证据状态，不属于业务阶段。"@zh
    ] ;
    sh:property [
        sh:path stock:evidenceState ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "STRUCTURED_SOURCE"
            "PLATFORM_CLASSIFICATION_ONLY"
            "PRODUCT_DISCLOSED"
            "REVENUE_DISCLOSED"
            "COMPANY_DENIAL"
            "EVIDENCE_INSUFFICIENT"
        ) ;
        sh:message "证据状态值无效。"@zh
    ] ;
    sh:property [
        sh:path stock:confidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "Claim置信度必须在0到1之间。"@zh
    ] ;
    sh:property [
        sh:path stock:recordedAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Claim必须记录系统入库时间。"@zh
    ] ;
    sh:property [
        sh:path stock:ontologyVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:message "Claim必须记录语义化本体版本。"@zh
    ] .

stock:ClaimValidTimeShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim的validTo必须晚于validFrom。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:validFrom ?start ; stock:validTo ?end .
                FILTER (?end <= ?start)
            }
        """
    ] .

stock:ClaimSystemTimeShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim的supersededAt必须晚于recordedAt。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:recordedAt ?start ; stock:supersededAt ?end .
                FILTER (?end <= ?start)
            }
        """
    ] .

stock:AcceptedClaimEvidenceShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ACCEPTED Claim必须至少有一个证据片段或明确结构化来源。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this
            WHERE {
                $this stock:claimStatus "ACCEPTED" .
                FILTER NOT EXISTS { $this stock:supportedBy ?evidence }
                FILTER NOT EXISTS { $this prov:wasDerivedFrom ?source }
                FILTER NOT EXISTS { $this stock:evidenceState "STRUCTURED_SOURCE" }
            }
        """
    ] .

stock:ProductionClaimEvidenceShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "量产Claim不能只由平台概念标签支持。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:businessStage "MASS_PRODUCTION" ;
                      stock:evidenceState "PLATFORM_CLASSIFICATION_ONLY" .
            }
        """
    ] .

stock:RevenueDisclosureShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REVENUE_DISCLOSED必须记录报告期。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:evidenceState "REVENUE_DISCLOSED" .
                FILTER NOT EXISTS { $this stock:reportPeriod ?period }
            }
        """
    ] .

stock:PlatformTagClaimShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "TAGGED_AS必须保持平台分类语义，不能带非UNKNOWN业务阶段。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:predicateCode "TAGGED_AS" .
                {
                    FILTER NOT EXISTS {
                        $this stock:evidenceState "PLATFORM_CLASSIFICATION_ONLY"
                    }
                }
                UNION
                {
                    $this stock:businessStage ?stage .
                    FILTER (?stage != "UNKNOWN")
                }
            }
        """
    ] .

stock:DenialClaimShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "DENIES_INVOLVEMENT必须使用COMPANY_DENIAL证据状态并保存文本证据。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:predicateCode "DENIES_INVOLVEMENT" .
                {
                    FILTER NOT EXISTS { $this stock:evidenceState "COMPANY_DENIAL" }
                }
                UNION
                {
                    FILTER NOT EXISTS { $this stock:supportedBy ?evidence }
                }
            }
        """
    ] .

stock:ProducesObjectShape
    a sh:NodeShape ;
    sh:targetClass stock:Claim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "PRODUCES和DEVELOPS的对象必须是Product。"@zh ;
        sh:select """
            PREFIX stock: <https://ontology.example.com/stock#>
            SELECT $this
            WHERE {
                $this stock:predicateCode ?predicate ;
                      stock:claimObject ?object .
                FILTER (?predicate IN ("PRODUCES", "DEVELOPS", "HAS_REVENUE_FROM"))
                FILTER NOT EXISTS { ?object a stock:Product }
            }
        """
    ] .

# ---------------------------------------------------------------------------
# Evidence and financial observations
# ---------------------------------------------------------------------------

stock:EvidenceFragmentShape
    a sh:NodeShape ;
    sh:targetClass stock:EvidenceFragment ;
    sh:property [
        sh:path stock:partOfDocument ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class stock:Document ;
        sh:message "证据片段必须关联一份来源文档。"@zh
    ] ;
    sh:property [
        sh:path stock:quoteText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 5 ;
        sh:message "证据片段必须保留可定位原文。"@zh
    ] ;
    sh:property [
        sh:path stock:pageNumber ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "页码必须是大于等于1的整数。"@zh
    ] .

stock:FinancialObservationShape
    a sh:NodeShape ;
    sh:targetClass stock:FinancialObservation ;
    sh:property [
        sh:path stock:observedFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class stock:Security ;
        sh:message "财务观察值必须对应一个证券。"@zh
    ] ;
    sh:property [
        sh:path stock:observesMetric ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class stock:FinancialMetric ;
        sh:message "财务观察值必须对应一个指标。"@zh
    ] ;
    sh:property [
        sh:path stock:reportPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "财务观察值必须记录报告期。"@zh
    ] ;
    sh:property [
        sh:path stock:metricValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "财务观察值必须有数值。"@zh
    ] ;
    sh:property [
        sh:path stock:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "财务观察值必须记录单位。"@zh
    ] .
